{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "nexthire-ai",
  "framework": "nextjs",
  "cleanUrls": true,
  "regions": ["bom1"],
  "functions": {
    "app/api/**/*": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/ai/**/*": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
