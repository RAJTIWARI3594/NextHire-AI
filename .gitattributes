# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit Source Code Formatting
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf

# Binary Asset Formats
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.ttf      binary
*.woff     binary
*.woff2    binary
